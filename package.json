{
	"name": "claude-usage-streamdeck",
	"version": "0.1.0",
	"private": true,
	"description": "Stream Deck plugin showing remaining Claude plan usage (5-hour and weekly windows).",
	"type": "module",
	"scripts": {
		"build": "rollup -c",
		"watch": "rollup -c -w --watch.onEnd=\"streamdeck restart com.pixelchew.claude-usage\"",
		"typecheck": "tsc --noEmit",
		"install-bridge": "node bridge/install.mjs",
		"remove-bridge": "node bridge/install.mjs --remove",
		"validate": "streamdeck validate com.pixelchew.claude-usage.sdPlugin",
		"pack": "npm run build && streamdeck pack com.pixelchew.claude-usage.sdPlugin --force"
	},
	"devDependencies": {
		"@elgato/cli": "^1.10.3",
		"@rollup/plugin-commonjs": "^29.0.2",
		"@rollup/plugin-node-resolve": "^15.2.2",
		"@rollup/plugin-terser": "^1.0.0",
		"@rollup/plugin-typescript": "^12.1.0",
		"@tsconfig/node20": "^20.1.2",
		"@types/node": "~24.1.0",
		"rollup": "^4.0.2",
		"tslib": "^2.6.2",
		"typescript": "^5.2.2"
	},
	"dependencies": {
		"@elgato/streamdeck": "^3.0.3"
	}
}
